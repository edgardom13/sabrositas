{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/**/*.html", "/**/*.css", "/**/*.js", "/manifest.webmanifest"],
        "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|eot|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "supabase-datos",
      "urls": ["https://vpousfdrqaiqonbnkaeb.supabase.co/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "10m",
        "timeout": "3s"
      }
    }
  ]
}